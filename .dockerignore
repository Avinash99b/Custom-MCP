# Docker build context exclusions.
#
# Keep the build context small and exclude anything that must never reach the
# image (local data, virtualenvs, secrets, VCS metadata).

# Version control / CI
.git
.gitignore
.github

# Python virtualenvs and caches
.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.mypy_cache
.ruff_cache
.pytest_cache

# Local runtime data and secrets (never bake these into an image)
data
.env
.env.*

# Tests, docs and tooling are not needed at runtime
tests
docs
plugin_examples
*.md
!README.md
