# Custom MCP gateway — example environment file.
#
# Copy this file to `.env` and fill in real values before `docker compose up`:
#
#     cp .env.example .env
#
# Compose reads `.env` both for variable interpolation and, through the app
# service's `env_file`, into the container. Never commit a real `.env` — the
# values below are development placeholders, not secrets.

# --- Required ---------------------------------------------------------------

# Shared secret used to sign session cookies and authenticate admin/API
# requests. MUST be at least 16 characters. Generate a strong value, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is a development-only value and is NOT a real secret.
MCP_SECRET=change-me-please-16plus

# Public origin the gateway is reachable at. Bare http(s) origin: no path and
# no trailing slash. HTTPS is required outside localhost.
BASE_URL=https://mcp.example.com

# --- Optional (defaults shown) ---------------------------------------------

# Redis connection string. Inside Compose this must point at the `redis`
# service name. Redis has no published host port by default.
REDIS_URL=redis://redis:6379/0

# Directory for persistent plugin packages and state; mounted as a volume.
DATA_DIR=/data

# Interface and port uvicorn binds to inside the container.
HOST=0.0.0.0
PORT=8000

# COOKIE_SECURE is derived from BASE_URL: an `https://` BASE_URL enables secure
# cookies automatically. Set it explicitly only to override that derivation.
# COOKIE_SECURE=true

# Application / uvicorn log level (CRITICAL|ERROR|WARNING|INFO|DEBUG|NOTSET).
# LOG_LEVEL=INFO
